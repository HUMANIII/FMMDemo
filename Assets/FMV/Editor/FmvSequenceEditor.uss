.editor-root { flex-grow: 1; background-color: rgb(32, 36, 41); }
.toolbar { flex-direction: row; padding-left: 6px; padding-right: 6px; padding-top: 6px; padding-bottom: 6px; background-color: rgb(43, 48, 54); }
.sequence-picker { flex-grow: 1; min-width: 170px; margin-right: 8px; }
.workspace { flex-grow: 1; }
.graph-pane { flex-grow: 1; }
.right-pane { min-width: 275px; background-color: rgb(45, 49, 55); }
.details-pane { flex-grow: 1; min-height: 0; padding-left: 10px; padding-right: 10px; padding-top: 8px; }
.video-preview { flex-shrink: 0; padding: 8px 10px; border-top-width: 1px; border-top-color: rgb(83, 93, 101); }
#preview-heading { -unity-font-style: bold; color: rgb(185, 228, 214); }
.preview-clip-name { margin-top: 3px; margin-bottom: 5px; overflow: hidden; text-overflow: ellipsis; }
.preview-image { height: 155px; background-color: rgb(15, 17, 20); }
.preview-controls { flex-direction: row; margin-top: 5px; }
.preview-controls Button { flex-grow: 1; }
.preview-status { font-size: 11px; color: rgb(185, 191, 199); white-space: normal; margin-top: 4px; }
.section-title { font-size: 16px; -unity-font-style: bold; margin-top: 12px; margin-bottom: 8px; color: rgb(185, 228, 214); }
.node-id { font-size: 10px; color: rgb(179, 186, 191); white-space: normal; margin-bottom: 8px; }
.field-row { flex-direction: row; margin-top: 5px; margin-bottom: 5px; }
.choice-card { border-top-width: 1px; border-top-color: rgb(83, 93, 101); padding-top: 8px; margin-top: 8px; }
.choice-name { flex-grow: 1; }
.diagnostic { white-space: normal; -unity-text-align: middle-left; margin-top: 5px; min-height: 30px; }
.error-item { color: rgb(255, 159, 154); }
.warning-item { color: rgb(245, 205, 132); }
.play-notice { padding-left: 10px; padding-top: 5px; padding-bottom: 5px; background-color: rgb(92, 67, 34); }
.hidden { display: none; }
.help-footer { padding-left: 10px; padding-top: 5px; padding-bottom: 5px; color: rgb(185, 191, 199); white-space: normal; font-size: 11px; }
.fmv-node { min-width: 255px; max-width: 310px; }
.fmv-node #title { background-color: rgb(47, 83, 84); }
.fmv-node.start-node #title { background-color: rgb(55, 104, 76); }
.fmv-node.has-error #title { background-color: rgb(129, 54, 55); }
.fmv-node.has-warning #title { border-bottom-width: 2px; border-bottom-color: rgb(225, 172, 83); }
.video-select { margin-top: 7px; margin-bottom: 7px; min-height: 30px; white-space: normal; }
.node-status { margin-left: 8px; margin-right: 8px; margin-bottom: 6px; white-space: normal; color: rgb(202, 211, 218); }
.timeout-info { color: rgb(249, 195, 111); }
