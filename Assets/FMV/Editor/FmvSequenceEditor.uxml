<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="FmvSequenceEditor.uss" />
    <ui:VisualElement name="editorRoot" class="editor-root">
        <ui:VisualElement name="toolbar" class="toolbar" />
        <ui:Label name="playNotice" text="Play 중에는 읽기 전용입니다. 영상 이름을 누르면 Inspector에서 확인할 수 있습니다." class="play-notice" />
        <ui:VisualElement name="workspace" class="workspace" />
        <ui:Label text="노드 배경: 선택 · 영상 이름: Inspector · 연결점 드래그: 연결 · Delete: 삭제 · Ctrl+S: 저장 · 마우스 휠: 확대/축소" class="help-footer" />
    </ui:VisualElement>
</ui:UXML>
